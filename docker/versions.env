# Pinned third-party pieces of the game image (and of scripts/setup_wine.sh).
# Each download is checked against its sha256; bump URL and hash together.

PLAYLUNKY_URL=https://github.com/spelunky-fyi/Playlunky/releases/download/v0.19.0/playlunky_v0.19.0.zip
PLAYLUNKY_SHA256=0bc18521587c6cd2785380f7f0c8fde8c7da8b4332373d5421258e142bf8323a
# One byte in playlunky64.dll so Playlunky runs our unsafe mod without a click in its menu (74 -> EB).
# Tied to this Playlunky build: when bumping it, find the new offset as docker/playlunky-patch.md says.
PLAYLUNKY_PATCH_OFFSET=0x7b340

# Goldberg Steam emulator (gbe_fork): replaces steam_api64.dll so no Steam client is needed
GBE_URL=https://github.com/Detanup01/gbe_fork/releases/download/release-2026_09_16_2/emu-win-release-vs22.7z
GBE_SHA256=d311deadc2a8a8aed620fe66976646059388123587aa22d408f723c592fc9688

DXVK_URL=https://github.com/doitsujin/dxvk/releases/download/v3.1.1/dxvk-3.1.1.tar.gz
DXVK_SHA256=40565b4a724aadc4433fa4e010b4b23916d9b1f1baeee64e17186db94f54e608

# Official 7-Zip: py7zr and older p7zip cannot unpack gbe_fork's BCJ2 archives
